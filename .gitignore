/bash

# Generated public-release trees. The tracked README files describe each
# destination; staged code, data, and archives are rebuilt from source.
/releases/github/RW-Cite/
/releases/github/*.tar.gz
/releases/huggingface/corpus/RW-Cite-datasets-*/
/releases/huggingface/corpus/*.tar.gz
/releases/huggingface/domains/RW-Cite-domain-*/
/releases/huggingface/domains/*.tar.gz
/releases/huggingface/domains/COLLECTION_MANIFEST.json
